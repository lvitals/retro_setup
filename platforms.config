[ps1]
name = Sony - PlayStation
category = Sony
core_file = mednafen_psx_hw_libretro.so
core_name = Sony - PlayStation (Beetle PSX HW)
core_config_name = Beetle PSX HW
core_options = beetle_psx_hw_renderer = "vulkan"; beetle_psx_hw_renderer_software_fb = "disabled"; beetle_psx_hw_internal_resolution = "2x"; beetle_psx_hw_msaa = "1x"; beetle_psx_hw_fastboot = "enabled"; beetle_psx_hw_skip_bios = "enabled"; beetle_psx_hw_cpu_dynarec = "max performance"; beetle_psx_hw_dynarec_invalidate = "DMA Only"; beetle_psx_hw_depth = "32bpp"; beetle_psx_hw_dither_mode = "internal resolution"; beetle_psx_hw_filter = "bilinear"; beetle_psx_hw_pgxp_mode = "disabled"; beetle_psx_hw_cd_fastload = "4x"; beetle_psx_hw_crop_overscan = "disabled"; beetle_psx_hw_image_crop = "disabled"; beetle_psx_hw_image_offset = "disabled"; beetle_psx_hw_adaptive_smoothing = "disabled"
frontend_options = video_driver = "vulkan"; video_threaded = "true"; video_vsync = "true"; video_smooth = "true"; aspect_ratio_index = "1"; video_aspect_ratio_auto = "false"; video_scale_integer = "false"; audio_latency = "96"; audio_sync = "true"; audio_rate_control = "true"; audio_rate_control_delta = "0.005"; audio_max_timing_skew = "0.05"; run_ahead_enabled = "false"; rewind_enable = "false"
use_gamemode = true
extensions = chd, cue, iso, bin, pbp, m3u, toc, ccd
bios_files = scph5500.bin, scph5501.bin, scph5502.bin
obsolete_config_files = config/PCSX-ReARMed/PCSX-ReARMed.cfg; config/PCSX-ReARMed/PCSX-ReARMed.opt; config/SwanStation/SwanStation.cfg; config/SwanStation/SwanStation.opt; config/Sony - PlayStation/Sony - PlayStation.cfg; config/Sony - PlayStation/Sony - PlayStation.opt
color = blue

[ps2]
name = Sony - PlayStation 2
category = Sony
core_file = pcsx2_libretro.so
core_name = Sony - PlayStation 2 (LRPS2)
core_config_name = LRPS2
core_options = pcsx2_renderer = "Vulkan"; pcsx2_upscale_multiplier = "1x"; pcsx2_texture_filtering = "Bilinear (PS2)"; pcsx2_anisotropic_filtering = "Disabled"; pcsx2_blending_accuracy = "Basic"; pcsx2_fastboot = "enabled"; pcsx2_mtvu = "enabled"; pcsx2_instant_vu1 = "enabled"; pcsx2_ee_cycle_rate = "100% (Normal Speed)"; pcsx2_ee_cycle_skip = "Disabled"
frontend_options = video_driver = "vulkan"; video_threaded = "true"; video_vsync = "true"; audio_latency = "128"; audio_sync = "true"; run_ahead_enabled = "false"; rewind_enable = "false"
use_gamemode = true
extensions = elf, iso, ciso, chd, cso, bin, mdf, nrg, dump, gz, img, m3u
bios_files = pcsx2/bios
bios_extensions = bin, rom0
bios_copy_extensions = bin, rom0, rom1, rom2, erom, nvm, mec
bios_install_directory = pcsx2/bios
bios_min_size = 4194304
bios_missing_action = error
obsolete_config_files = config/PCSX2/PCSX2.cfg; config/PCSX2/PCSX2.opt; config/Sony - PlayStation 2/Sony - PlayStation 2.cfg; config/Sony - PlayStation 2/Sony - PlayStation 2.opt
color = blue

