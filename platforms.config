# Retro Setup Platform Catalog
# Clear, Human-Readable Configuration File for Platforms
# Colors can be specified by simple names (red, blue, green, yellow, purple, cyan, orange, etc.) or #RRGGBB hex.

[nes]
name = Nintendo - Nintendo Entertainment System
category = Nintendo
core_file = mesen_libretro.so
core_name = Nintendo - NES (Mesen)
extensions = nes
bios_files = disksys.rom
color = red

